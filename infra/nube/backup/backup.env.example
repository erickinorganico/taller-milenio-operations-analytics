# Datos literales, un valor por línea; sin comillas ni instrucciones de shell.
# Usa el endpoint S3 de tu propio bucket privado en Backblaze B2.
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/NOMBRE-DEL-BUCKET/taller
AWS_DEFAULT_REGION=us-west-004
AWS_ACCESS_KEY_ID=ID-DE-LA-LLAVE-DEL-BUCKET
AWS_SECRET_ACCESS_KEY=SECRETO-DE-LA-LLAVE-DEL-BUCKET
RESTIC_PASSWORD_FILE=/etc/milenio/restic-password
