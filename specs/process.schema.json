{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taller Milenio analytical process definition",
  "type": "object",
  "required": ["schema_version", "process_id", "title", "purpose", "accountable_owner", "scope", "roles", "entities", "metrics", "agents", "evidence", "controls", "nodes", "transitions", "acceptance_tests"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "process_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "title": {"type": "string", "minLength": 5},
    "purpose": {"type": "string", "minLength": 20},
    "accountable_owner": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "required": ["trigger", "end", "exclusions"]},
    "roles": {"type": "array", "minItems": 2},
    "entities": {"type": "array", "minItems": 1, "uniqueItems": true},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true},
    "agents": {"type": "array", "minItems": 1, "uniqueItems": true},
    "evidence": {"type": "array", "minItems": 1},
    "controls": {"type": "array", "minItems": 1},
    "nodes": {"type": "array", "minItems": 4},
    "transitions": {"type": "array", "minItems": 3},
    "acceptance_tests": {"type": "array", "minItems": 3}
  },
  "additionalProperties": false
}
